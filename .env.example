# Application
APP_NAME=Medicalka
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Databases (compose service hostnames)
DATABASE_URL=postgresql+psycopg2://medicalka:medicalka@db:5432/medicalka
TEST_DATABASE_URL=postgresql+psycopg2://medicalka:medicalka@db_test:5432/medicalka_test

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Verification & cleanup
VERIFICATION_TOKEN_TTL_HOURS=24
UNVERIFIED_USER_TTL_HOURS=48
CLEANUP_SCHEDULE_CRON_HOUR=*/1
